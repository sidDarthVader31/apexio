# Apexio local configuration (copy to .env and adjust)
# Never commit real secrets. Services read these via docker compose env or shell export.

# --- Gateway ---
GATEWAY_ADDR=:8080
GATEWAY_OTLP_GRPC_ADDR=:4317
# Optional API key auth (empty = disabled). Clients send header below.
GATEWAY_API_KEY=
GATEWAY_API_KEY_HEADER=X-API-Key

# --- Redpanda / Kafka API ---
REDPANDA_BROKERS=localhost:19092
REDPANDA_CLIENT_ID=apexio-gateway
REDPANDA_GROUP_ID=apexio-writer
LOG_TOPIC=logs.ingestion.raw.v1

# --- Writer ---
WRITER_HEALTH_ADDR=:8081
WRITER_BATCH_SIZE=50
WRITER_FLUSH_INTERVAL=1s
WRITER_MAX_RETRIES=3
WRITER_RETRY_BACKOFF=200ms

# --- ClickHouse ---
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=apexio
CLICKHOUSE_TABLE=logs
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Sample client ---
APEXIO_GATEWAY=http://127.0.0.1:18080
