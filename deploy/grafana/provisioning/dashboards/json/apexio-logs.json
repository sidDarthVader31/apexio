          "editorMode": "code",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  floor(response_duration_ms / 50) * 50 AS bucket,\n  count() AS count\nFROM apexio.logs\nWHERE $__timeFilter_ms(timestamp)\n  AND response_duration_ms > 0\nGROUP BY bucket\nORDER BY bucket",
