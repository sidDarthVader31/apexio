          "rawSql": "SELECT\n  timestamp,\n  service,\n  log_level,\n  message,\n  request_path,\n  response_status\nFROM apexio.logs\nWHERE $__timeFilter_ms(timestamp)\n  AND log_level IN ('ERROR', 'FATAL')\nORDER BY timestamp DESC\nLIMIT 100",
