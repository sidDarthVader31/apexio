          "rawSql": "SELECT\n  $__timeInterval_ms(timestamp) AS time,\n  count() AS value\nFROM apexio.logs\nWHERE $__timeFilter_ms(timestamp)\n  AND log_level IN ('ERROR', 'FATAL')\nGROUP BY time\nORDER BY time",
